# Demo settings. Copy to .env (gitignored). Never commit real keys.
AMUTAH_ENVIRONMENT=demo
AMUTAH_DATABASE_URL=sqlite:///./amutah_demo.db
AMUTAH_STORAGE_BACKEND=local
AMUTAH_LOCAL_STORAGE_DIR=./var/documents
AMUTAH_AUTH_BACKEND=local_dev
AMUTAH_NOTIFIER_BACKEND=console
# Fill with: uv run python -m app.scripts.gen_keys >> .env (then delete these empty lines)
AMUTAH_NATIONAL_ID_HMAC_KEY=
AMUTAH_FIELD_ENCRYPTION_KEY=
AMUTAH_SIGNING_KEY=
